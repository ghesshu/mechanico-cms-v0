# Development Dockerfile for Strapi Monorepo
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    sqlite \
    sqlite-dev \
    vips-dev \
    libc6-compat

# Enable Yarn
RUN corepack enable

# Copy package files for dependency installation
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn

# Copy workspace package.json files
COPY packages/*/package.json ./packages/*/
COPY packages/*/*/package.json ./packages/*/*/
COPY examples/*/package.json ./examples/*/
COPY scripts/*/package.json ./scripts/*/

# Install dependencies
RUN yarn install --immutable

# Copy source code
COPY . .

# Build the packages
RUN yarn build

# Set working directory to the getstarted example
WORKDIR /app/examples/getstarted

# Expose the default Strapi port
EXPOSE 1337

# Set environment variables for development
ENV NODE_ENV=development
ENV STRAPI_DISABLE_UPDATE_NOTIFICATION=true
ENV STRAPI_HIDE_STARTUP_MESSAGE=true

# Create volume for persistent data
VOLUME ["/app/examples/getstarted/data"]

# Start the development server
CMD ["yarn", "develop"]