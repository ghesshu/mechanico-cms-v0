# Strapi Configuration
NODE_ENV=development
STRAPI_PORT=1337
HOST=0.0.0.0
PORT=1337

# Database Configuration
# Supported clients: sqlite, postgres, mysql
DATABASE_CLIENT=postgres

# For PostgreSQL
DATABASE_HOST=your-postgres-host.com
DATABASE_PORT=5432
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=your_secure_password
DATABASE_SSL=false

# For MySQL (uncomment and modify if using MySQL)
# DATABASE_CLIENT=mysql
# DATABASE_HOST=your-mysql-host.com
# DATABASE_PORT=3306
# DATABASE_NAME=strapi_db
# DATABASE_USERNAME=strapi_user
# DATABASE_PASSWORD=your_secure_password

# For SQLite (uncomment if using SQLite)
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=./data/data.db

# Strapi Secrets (Generate secure values for production)
JWT_SECRET=your-super-secure-jwt-secret-here
ADMIN_JWT_SECRET=your-super-secure-admin-jwt-secret-here
APP_KEYS=key1-here,key2-here,key3-here,key4-here
API_TOKEN_SALT=your-api-token-salt-here
TRANSFER_TOKEN_SALT=your-transfer-token-salt-here

# Strapi Settings
STRAPI_DISABLE_UPDATE_NOTIFICATION=true
STRAPI_HIDE_STARTUP_MESSAGE=true

# Example configurations for popular cloud databases:

# AWS RDS PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_HOST=your-rds-instance.region.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_SSL=true

# Google Cloud SQL PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_HOST=your-instance-ip
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_SSL=true

# Azure Database for PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_HOST=your-server.postgres.database.azure.com
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=username@your-server
# DATABASE_PASSWORD=your_password
# DATABASE_SSL=true

# PlanetScale (MySQL)
# DATABASE_CLIENT=mysql
# DATABASE_HOST=your-host.psdb.cloud
# DATABASE_PORT=3306
# DATABASE_NAME=your-database
# DATABASE_USERNAME=your-username
# DATABASE_PASSWORD=your-password
# DATABASE_SSL=true

# Supabase PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_HOST=db.your-project.supabase.co
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_SSL=true